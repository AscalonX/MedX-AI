# Line endings: store and check out text as LF on every OS (overrides core.autocrlf=true on Windows).
# Data-driven tests and docs/clinical/check-*.mjs parse markdown tables and prompt blocks; CRLF made them parse 0 rows.
* text=auto eol=lf

# Windows-only scripts keep CRLF if any are added.
*.bat text eol=crlf
*.cmd text eol=crlf

