# MedX environment. Copy to apps/web/.env.local (local dev), pass with `docker run --env-file`, or set in the
# Vercel/Render dashboard. Never commit real keys (.env and .env.* are git- and vercel-ignored).
# Synthetic data only. Research prototype: decision support for clinicians, not a medical device.

# ---- Model provider ---------------------------------------------------------------------------------
# "mock" = deterministic, offline (tests, demo without a key). "amd" = Gemma on AMD via Token Factory.
# Set it explicitly: anything other than "mock" selects the AMD provider.
MODEL_PROVIDER=mock

# AMD Token Factory (OpenAI-compatible). Base URL ends in /v1; model ids come from the Token Factory console.
AMD_BASE_URL=
AMD_API_KEY=
AMD_MODEL=
# Optional second Gemma id used on provider error
AMD_MODEL_FALLBACK=
# Optional: a second Token Factory model for the long structured extraction only (the red-flag screen and next
# question stay on AMD_MODEL). Every call records its model id in the audit and the Case trace.
AMD_EXTRACT_MODEL=
# Optional: "false" disables response_format json_schema if the endpoint rejects it
# AMD_JSON_SCHEMA=true
# Optional: hardware label shown by /api/health and the landing page when the AMD provider is active
# AMD_HARDWARE_LABEL=AMD (via Token Factory)

# Per-call timeout in ms for every step (defaults: 40000 extraction, 11000 next question, 12000 red-flag screen; the turn deadline is 52000)
LLM_TIMEOUT_MS=

# ---- Demo -------------------------------------------------------------------------------------------
# 1 enables the synthetic demo: POST /api/demo/reset and POST /api/dev/seed (both need header
# x-demo-token: $DEMO_TOKEN), the persona demo routes and the daily cron reset. Leave unset in any real deployment.
DEMO_SEED=1
# 1 replays the synthetic seed once when the store is empty (first request after a cold start or reset).
DEMO_AUTOSEED=1
# Secret for the demo reset/seed routes. Without it those routes answer 404. Generate: openssl rand -hex 24
DEMO_TOKEN=
# Secret Vercel Cron sends as "Authorization: Bearer $CRON_SECRET" to GET /api/cron/reset (daily, 03:00 ICT).
# Without it the cron route answers 401.
CRON_SECRET=

# ---- Store ------------------------------------------------------------------------------------------
# postgres | redis | file. Unset = auto-detect: DATABASE_URL/POSTGRES_URL -> postgres, Upstash URL+token -> redis,
# else file. Vercel needs a shared store (instances do not share memory or /tmp). Tests always use the file store.
# MEDX_STORE=
# Neon serverless Postgres over HTTP (primary shared store; Vercel's Neon integration sets both names).
# One table, medx_store, is created on first use. Use a Singapore (ap-southeast-1) database to sit next to sin1.
DATABASE_URL=
# POSTGRES_URL=
# Optional Upstash Redis REST (alternative snapshot store, and shared per-IP rate limit when set).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Key namespace (medx:<ns>:...). Unset = VERCEL_ENV (production/preview/development), else "local".
MEDX_STORE_NS=
# File store path. Default apps/web/.data/store.json; on Vercel os.tmpdir()/medx/store.json (per instance, ephemeral).
MEDX_STORE_PATH=

# ---- Public URL and security ------------------------------------------------------------------------
# Canonical public URL (landing links, QR code to /patient), e.g. https://medx.areazeroai.com
NEXT_PUBLIC_SITE_URL=
# Extra CORS origins for the API, comma-separated (same origin is always allowed).
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# POSTs per minute per client IP before 429 (default 30; 0 disables). Shared across instances only with Upstash.
# MEDX_RATE_LIMIT_PER_MIN=30
# 1 = clinical writes must come from a known staff id with the right role (403 otherwise).
# MEDX_STRICT_ROLES=
# Clinic timezone for the "today" counts in /api/metrics (sessions today, collected today). Default Asia/Bangkok.
# MEDX_TZ=Asia/Bangkok

# ---- Build and runtime metadata (reported by /api/health) -------------------------------------------
# Commit id for CLI deploys (git deploys get VERCEL_GIT_COMMIT_SHA): vercel deploy --build-env MEDX_COMMIT=$(git rev-parse --short HEAD)
# MEDX_COMMIT=
# Region label outside Vercel (Vercel sets VERCEL_REGION itself).
# MEDX_REGION=
# Check builds that must not collide with another build in .next: MEDX_DIST_DIR=.next-check npx next build
# MEDX_DIST_DIR=
# Docker/Render listen port
# PORT=3000

# ---- Patient app (apps/mobile) ----------------------------------------------------------------------
# URL of the web server reachable from a physical phone. Leave unset for the web export served at /patient.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Medicine-pack photo (pharmacist "Add from photo"): vision model on the AMD developer API. Slow (~50 s); default shown.
AMD_MODEL_VISION=MiniCPM-V-4.7-35B-A3B
