# Copy to apps/web/.env.local (local dev) or pass with `docker run --env-file` / compose. Never commit real keys.

# Model provider: "amd" (Gemma on AMD via Token Factory) or "mock" (deterministic, offline, tests/demo without a key)
MODEL_PROVIDER=mock

# AMD Token Factory (OpenAI-compatible). Copy the base URL (ends in /v1) and model ids from the Token Factory console.
AMD_BASE_URL=
AMD_API_KEY=
AMD_MODEL=
# Optional second Gemma id used on provider error
AMD_MODEL_FALLBACK=
# Optional: "false" to disable response_format json_schema if the endpoint rejects it
# AMD_JSON_SCHEMA=true

# Per-call timeout in ms (defaults: 25000 extraction, 8000 next question)
LLM_TIMEOUT_MS=

# 1 enables POST /api/demo/reset and /api/dev/seed (synthetic fixtures). Leave unset outside demos.
DEMO_SEED=1
DEMO_AUTOSEED=1
# Required in x-demo-token for reset/seed requests. Generate a random secret; never commit it.
DEMO_TOKEN=
# Optional durable local JSON file. Defaults to apps/web/.data/store.json.
MEDX_STORE_PATH=

# Patient app on a physical phone: URL of the web server reachable from the phone (apps/mobile)
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
