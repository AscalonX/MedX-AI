{
  "expo": {
    "name": "MedX",
    "slug": "medx-bridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-3d.png",
    "scheme": "medx",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.medx.bridge",
      "icon": "./assets/brand/icon-3d.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground-3d.png",
        "backgroundColor": "#0A8077"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-3d.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MedX uses the microphone so you can speak your answers. Your voice is converted to text by Apple or Google speech recognition on your device's operating system. You always confirm the text before it is sent.",
          "speechRecognitionPermission": "MedX uses Apple or Google speech recognition to turn your voice into text. Audio may be processed by that service. You check the text before sending."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/patient"
    }
  }
}
